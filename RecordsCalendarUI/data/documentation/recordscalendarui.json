t":{"title":"RecordsCalendarWeekTitleContext","type":"topic","abstract":[],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordsCalendarWeekTitleContext"}],"url":"\/documentation\/recordscalendarui\/recordscalendarweektitlecontext","navigatorTitle":[{"kind":"identifier","text":"RecordsCalendarWeekTitleContext"}],"identifier":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarWeekTitleContext","role":"symbol","kind":"symbol"}}}