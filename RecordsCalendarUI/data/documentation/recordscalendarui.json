opic","role":"symbol","kind":"symbol","abstract":[],"url":"\/documentation\/recordscalendarui\/recordscalendarview"},"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarTheme":{"title":"RecordsCalendarTheme","navigatorTitle":[{"kind":"identifier","text":"RecordsCalendarTheme"}],"identifier":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarTheme","role":"symbol","type":"topic","abstract":[],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordsCalendarTheme"}],"kind":"symbol","url":"\/documentation\/recordscalendarui\/recordscalendartheme"},"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarConfiguration":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordsCalendarConfiguration","kind":"identifier"}],"title":"RecordsCalendarConfiguration","navigatorTitle":[{"text":"RecordsCalendarConfiguration","kind":"identifier"}],"identifier":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarConfiguration","type":"topic","role":"symbol","kind":"symbol","abstract":[],"url":"\/documentation\/recordscalendarui\/recordscalendarconfiguration"},"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarEntry":{"title":"RecordsCalendarEntry","navigatorTitle":[{"kind":"identifier","text":"RecordsCalendarEntry"}],"identifier":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarEntry","role":"symbol","type":"topic","abstract":[],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordsCalendarEntry"}],"kind":"symbol","url":"\/documentation\/recordscalendarui\/recordscalendarentry"},"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarBestValueComparator":{"type":"top