{"variants":[{"paths":["\/documentation\/recordscalendarui"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Calendar Presentation","identifiers":["doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarView","doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarConfiguration","doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarWeekTitleContext","doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarTheme","doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarDisplayScope"],"anchor":"Calendar-Presentation"},{"title":"Record Model Boundary","identifiers":["doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarEntry"],"anchor":"Record-Model-Boundary"},{"title":"Structures","anchor":"Structures","identifiers":["doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarBestValueComparator","doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarDayAccessibilityContext"],"generated":true}],"kind":"symbol","metadata":{"title":"RecordsCalendarUI","symbolKind":"module","modules":[{"name":"RecordsCalendarUI"}],"role":"collection","roleHeading":"Framework","externalID":"RecordsCalendarUI"},"abstract":[{"type":"text","text":"Reusable SwiftUI calendar records UI for apps that own their own data, persistence, and navigation."}],"hierarchy":{"paths":[[]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"code":"RecordsCalendarUI","type":"codeVoice"},{"text":" provides presentation-only calendar components for record-based apps. Host apps pass records, display configuration, selection state, and callbacks while keeping storage and detail navigation outside the package.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use this package when you need a reusable week\/month calendar with a selected-day list and swipe-to-delete behavior, but each app needs different record values, text formatting, and detail screens."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Week scope uses the display calendar’s locale and first weekday to create a localized year, month, and week-of-month header. A Korean calendar displays a title such as "},{"type":"codeVoice","code":"2026년 7월 1주차"},{"type":"text","text":" without host formatting, and the week number follows the visible calendar grid."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Built-in week-title localizations cover English, Simplified Chinese, Traditional Chinese, French, German, Italian, Japanese, Korean, Portuguese (Portugal), and Spanish. Other locales fall back to English."}],"type":"paragraph"},{"inlineContent":[{"text":"Calendar navigation, week\/month scope changes, day selection, and record detail selection provide native haptic feedback. Tappable calendar and record surfaces also use a bouncy press response while respecting the Reduce Motion accessibility setting.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"RecordsCalendarConfiguration.rowHeight"},{"type":"text","text":" controls the minimum selected-day row card height. "},{"type":"codeVoice","code":"RecordsCalendarConfiguration.rowSpacing"},{"type":"text","text":" controls the vertical spacing between selected-day rows, defaults to 5 points, can be customized by host apps, and clamps negative values to zero. Values below "},{"type":"codeVoice","code":"RecordsCalendarConfiguration<YourRecord>.minimumRowHeight"},{"type":"text","text":", currently 44 points, are clamped so row content keeps a standard touch target. Row spacing does not reduce the configured row height. "},{"type":"codeVoice","code":"RecordsCalendarConfiguration<YourRecord>.minimumRowHeight(forRowSpacing:)"},{"type":"text","text":" remains as a deprecated compatibility helper; use "},{"type":"codeVoice","code":"minimumRowHeight"},{"type":"text","text":" for new code."}],"type":"paragraph"},{"inlineContent":[{"code":"RecordsCalendarConfiguration.theme","type":"codeVoice"},{"type":"text","text":" accepts semantic colors through "},{"type":"codeVoice","code":"RecordsCalendarTheme"},{"type":"text","text":", including the full-page background, calendar and record container background, primary and secondary page content colors, optional container-only primary and secondary content colors, and independent light and dark summary tile backgrounds. The default "},{"code":".standard","type":"codeVoice"},{"type":"text","text":" theme preserves the system grouped page background, material calendar container, grouped record containers, and existing green appearance. Host apps can supply adaptive SwiftUI colors without changing package internals."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Theme initialization without an explicit light-mode secondary content color remains supported and derives that color from ","type":"text"},{"code":"contentColor","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To change only surfaces, copy ","type":"text"},{"code":".standard","type":"codeVoice"},{"text":" and set ","type":"text"},{"code":"backgroundColor","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"containerBackgroundColor","type":"codeVoice"},{"text":". The package applies the container color consistently to the calendar, selected-day empty state, and record rows. Set ","type":"text"},{"code":"containerContentColor","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"containerSecondaryContentColor","type":"codeVoice"},{"text":" when those containers need a foreground palette that differs from the page. Selected calendar days continue to use the page primary content color so it remains paired with ","type":"text"},{"code":"selectedDayBackgroundColor","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calendar day buttons can receive an accessibility label and value from "},{"type":"codeVoice","code":"RecordsCalendarConfiguration"},{"type":"text","text":". The package passes a "},{"type":"codeVoice","code":"RecordsCalendarDayAccessibilityContext"},{"type":"text","text":" with the date, its display calendar, and the today, selected, and has-records states so host apps can provide their own localized full-date label and state text. Use "},{"type":"codeVoice","code":"context.calendar"},{"type":"text","text":" when formatting the date so its locale and time zone stay consistent with the visible calendar. When these closures are omitted, the package preserves SwiftUI’s default day-number announcement. Selected dates also use the system selected accessibility trait."}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI"},"references":{"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarConfiguration":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordsCalendarConfiguration","kind":"identifier"}],"title":"RecordsCalendarConfiguration","navigatorTitle":[{"text":"RecordsCalendarConfiguration","kind":"identifier"}],"kind":"symbol","role":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarConfiguration","url":"\/documentation\/recordscalendarui\/recordscalendarconfiguration"},"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarWeekTitleContext":{"kind":"symbol","type":"topic","abstract":[],"url":"\/documentation\/recordscalendarui\/recordscalendarweektitlecontext","title":"RecordsCalendarWeekTitleContext","identifier":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarWeekTitleContext","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordsCalendarWeekTitleContext"}],"navigatorTitle":[{"kind":"identifier","text":"RecordsCalendarWeekTitleContext"}],"role":"symbol"},"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarTheme":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordsCalendarTheme","kind":"identifier"}],"abstract":[],"url":"\/documentation\/recordscalendarui\/recordscalendartheme","title":"RecordsCalendarTheme","navigatorTitle":[{"text":"RecordsCalendarTheme","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarTheme","role":"symbol","type":"topic"},"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarView":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordsCalendarView","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"RecordsCalendarView","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarView","title":"RecordsCalendarView","url":"\/documentation\/recordscalendarui\/recordscalendarview","role":"symbol","abstract":[]},"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarDayAccessibilityContext":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordsCalendarDayAccessibilityContext"}],"abstract":[],"url":"\/documentation\/recordscalendarui\/recordscalendardayaccessibilitycontext","title":"RecordsCalendarDayAccessibilityContext","navig