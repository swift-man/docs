{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/recordscalendarui"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI"},"metadata":{"modules":[{"name":"RecordsCalendarUI"}],"role":"collection","roleHeading":"Framework","title":"RecordsCalendarUI","externalID":"RecordsCalendarUI","symbolKind":"module"},"topicSections":[{"identifiers":["doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarView","doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarConfiguration","doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarWeekTitleContext","doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarTheme","doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarDisplayScope"],"title":"Calendar Presentation","anchor":"Calendar-Presentation"},{"identifiers":["doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarEntry"],"title":"Record Model Boundary","anchor":"Record-Model-Boundary"},{"identifiers":["doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarBestValueComparator","doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarDayAccessibilityContext"],"title":"Structures","anchor":"Structures","generated":true}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"code":"RecordsCalendarUI","type":"codeVoice"},{"text":" provides presentation-only calendar components for record-based apps. Host apps pass records, display configuration, selection state, and callbacks while keeping storage and detail navigation outside the package.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use this package when you need a reusable week\/month calendar with a selected-day list and swipe-to-delete behavior, but each app needs different record values, text formatting, and detail screens.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Week scope uses the display calendar’s locale and first weekday to create a localized year, month, and week-of-month header. A Korean calendar displays a title such as ","type":"text"},{"code":"2026년 7월 1주차","type":"codeVoice"},{"text":" without host formatting, and the week number follows the visible calendar grid.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Built-in week-title localizations cover English, Simplified Chinese, Traditional Chinese, French, German, Italian, Japanese, Korean, Portuguese (Portugal), and Spanish. Other locales fall back to English."}],"type":"paragraph"},{"inlineContent":[{"text":"Calendar navigation, week\/month scope changes, day selection, and record detail selection provide native haptic feedback. Tappable calendar and record surfaces also use a bouncy press response while respecting the Reduce Motion accessibility setting.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"RecordsCalendarConfiguration.rowHeight","type":"codeVoice"},{"type":"text","text":" controls the minimum selected-day row card height. "},{"code":"RecordsCalendarConfiguration.rowSpacing","type":"codeVoice"},{"type":"text","text":" controls the vertical spacing between selected-day rows, defaults to 5 points, can be customized by host apps, and clamps negative values to zero. Values below "},{"code":"RecordsCalendarConfiguration<YourRecord>.minimumRowHeight","type":"codeVoice"},{"type":"text","text":", currently 44 points, are clamped so row content keeps a standard touch target. Row spacing does not reduce the configured row height. "},{"type":"codeVoice","code":"RecordsCalendarConfiguration<YourRecord>.minimumRowHeight(forRowSpacing:)"},{"type":"text","text":" remains as a deprecated compatibility helper; use "},{"type":"codeVoice","code":"minimumRowHeight"},{"type":"text","text":" for new code."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"RecordsCalendarConfiguration.theme"},{"text":" accepts semantic colors through ","type":"text"},{"type":"codeVoice","code":"RecordsCalendarTheme"},{"text":", including the full-page background, calendar and record container background, primary and secondary page content colors, optional container-only primary and secondary content colors, and independent light and dark summary tile backgrounds. The default ","type":"text"},{"type":"codeVoice","code":".standard"},{"text":" theme preserves the system grouped page background, material calendar container, grouped record containers, and existing green appearance. Host apps can supply adaptive SwiftUI colors without changing package internals.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Theme initialization without an explicit light-mode secondary content color remains supported and derives that color from ","type":"text"},{"code":"contentColor","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To change only surfaces, copy "},{"code":".standard","type":"codeVoice"},{"type":"text","text":" and set "},{"code":"backgroundColor","type":"codeVoice"},{"type":"text","text":" or "},{"code":"containerBackgroundColor","type":"codeVoice"},{"type":"text","text":". The package applies the container color consistently to the calendar, selected-day empty state, and record rows. Set "},{"code":"containerContentColor","type":"codeVoice"},{"type":"text","text":" and "},{"code":"containerSecondaryContentColor","type":"codeVoice"},{"type":"text","text":" when those containers need a foreground palette that differs from the page. Selected calendar days continue to use the page primary content color so it remains paired with "},{"code":"selectedDayBackgroundColor","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Calendar day buttons can receive an accessibility label and value from "},{"code":"RecordsCalendarConfiguration","type":"codeVoice"},{"type":"text","text":". The package passes a "},{"type":"codeVoice","code":"RecordsCalendarDayAccessibilityContext"},{"type":"text","text":" with the date, its display calendar, and the today, selected, and has-records states so host apps can provide their own localized full-date label and state text. Use "},{"type":"codeVoice","code":"context.calendar"},{"type":"text","text":" when formatting the date so its locale and time zone stay consistent with the visible calendar. When these closures are omitted, the package preserves SwiftUI’s default day-number announcement. Selected dates also use the system selected accessibility trait."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Reusable SwiftUI calendar records UI for apps that own their own data, persistence, and navigation.","type":"text"}],"kind":"symbol","sections":[],"hierarchy":{"paths":[[]]},"references":{"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarWeekTitleContext":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RecordsCalendarWeekTitleContext","kind":"identifier"}],"identifier":"doc:\/\/recordscalendarui.RecordsCalendarUI\/documentation\/RecordsCalendarUI\/RecordsCalendarWeekTitleContext","abstract":[],"title":"RecordsCalendarWeekTitleContext","navigatorTitle":[{"text":"RecordsCalendarWeekTitleContext","kind":"identifier"}],"url":"\/documentation\/recordscalendarui\/recordscalendarweektitlecontext","role":"symbol","kind":"symbol"},"doc://recordscalendarui.RecordsCalendarUI/documentation/RecordsCalendarUI/RecordsCalendarDisplayScope":{"navigatorTitle":[{"kind":"identifier","text":"RecordsCalenda