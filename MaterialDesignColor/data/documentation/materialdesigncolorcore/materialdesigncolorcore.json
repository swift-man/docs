t","code":["let theme = MaterialTheme.preset(.expressive, appearance: .light)","let primary = theme.colorScheme.primary","let keyPrimary = MaterialThemePreset.expressive.keyColors.primary"]},{"inlineContent":[{"text":"Material Theme Builder role colors can be injected with type-safe ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorRole","type":"reference"},{"text":" keys. Missing roles fall back to the selected preset.","type":"text"}],"type":"paragraph"},{"code":["let theme = try MaterialTheme.custom(","    appearance: .light,","    overrides: [","        .primary: \"#6750A4\",","        .onPrimary: \"#FFFFFF\",","        .primaryContainer: \"#EADDFF\",","        .onPrimaryContainer: \"#21005D\",","        .surface: \"#FFFBFE\",","        .onSurface: \"#1C1B1F\"","    ]",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"For existing call sites, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialTheme\/light","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialTheme\/dark","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme\/baselineLight","type":"reference"},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme\/baselineDark","type":"reference"},{"text":" remain aliases for the ","type":"text"},{"code":"tonalSpot","type":"codeVoice"},{"text":" preset.","type":"text"}],"type":"paragraph"},{"anchor":"Custom-status-colors","text":"Custom status colors","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The standard 48 roles remain unchanged. "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialExtendedColorRole","isActive":true},{"type":"text","text":" defines"},{"type":"text","text":" "},{"type":"text","text":"success\/onSuccess\/successContainer\/onSuccessContainer and the corresponding warning group."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialExtendedColors","isActive":true},{"type":"text","text":" stores immutable, harmonized light\/dark defaults."},{"type":"text","text":" "},{"type":"text","text":"Access them through "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme\/success","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme\/warning","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let safe = MaterialTheme.light.colorScheme.success","let scheme = try MaterialColorScheme.tonalSpotDark.overridingExtended([","  .warning: \"#FFB870\", .onWarning: \"#482900\"","])","let theme = MaterialTheme(colorScheme: scheme)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"In the SwiftUI adapter, apply ","type":"text"},{"code":".materialTheme(preset: .tonalSpot)","type":"codeVoice"},{"text":" at the root to","type":"text"},{"text":" ","type":"text"},{"text":"follow the system appearance, or ","type":"text"},{"code":".materialTheme(light: customLight, dark: customDark)","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"text":"The AppKit adapter provides ","type":"text"},{"type":"codeVoice","code":"MaterialColor.nsColor"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"NSColor(materialColor:)"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Seed-based schemes can be generated ahead of time with "},{"type":"codeVoice","code":"tools\/theme\/generate.mjs"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"see the repository README for installation and output formats."}],"type":"paragraph"},{"anchor":"%ED%85%9C%ED%94%8C%EB%A6%BF-%EA%B0%92%EA%B3%BC-%EC%95%B1-%ED%99%95%EC%A0%95-%EA%B0%92","text":"템플릿 값과 앱 확정 값","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"패키지는 롤 이름·구조와 템플릿 기본값, 주입 API, 대비 검증 도구를 제공합니다.","type":"text"},{"text":" ","type":"text"},{"text":"최종 제품 색은 앱이 확정합니다. success\/warning 기본값은 #6750A4에 조화시킨 템플릿이며,","type":"text"},{"text":" ","type":"text"},{"text":"앱이 제품 색상을 결정해 덮어쓰는 것을 전제로 합니다. 런타임 override는 앱 값을 재조화하지 않습니다.","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"경로"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"용도"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"프리셋"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"기본 역할 값의 출발점"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"tools\/theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"seed로 후보 스킴을 생성해 앱 프로젝트에 보관"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"값 기반 override \/ pair"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"앱 디자인·사용자 설정·시스템 색의 최종 값 주입"}],"type":"paragraph"}]]]},{"type":"codeListing","syntax":"swift","code":["let warning = MaterialColor(name: \"appWarning\", red: 128, green: 64, blue: 0)","let white = MaterialColor(name: \"white\", red: 255, green: 255, blue: 255)","let pair = MaterialTheme.pair(extendedLight: [.warning: warning, .onWarning: white])","let ratio = warning.contrastRatio(with: white)","let issues = pair.light.colorScheme.contrastIssues(minimum: 4.5)"]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialExtendedColors"},{"text":"의 공개 생성자는 모든 확장 역할을 MaterialColor로 받습니다.","type":"text"},{"text":" ","type":"text"},{"text":"UInt8 sRGB 생성자와 값 기반 overriding\/custom은 throw하지 않습니다.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialThemePair"},{"text":"의 light\/dark를 SwiftUI ","type":"text"},{"type":"codeVoice","code":".materialTheme(light:dark:)"},{"text":" 또는","type":"text"},{"text":" ","type":"text"},{"text":"AppKit\/UIKit ","type":"text"},{"type":"codeVoice","code":".material(light:dark:_:)"},{"text":"에 전달하세요.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\\.materialTheme"},{"text":" 환경 기본값은 MaterialTheme.light입니다. 모디파이어가 없는 장면은","type":"text"},{"text":" ","type":"text"},{"text":"자동 전환되지 않으므로 별도 창·설정 창에도 각 루트에 주입해야 합니다.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialContrastIssue"},{"text":"는 기본·확장 on 쌍의 미달 대비를 반환합니다. 실제 다른 인접 색상은","type":"text"},{"text":" ","type":"text"},{"text":"contrastRatio(with:)로 검사하세요. 투명도가 적용된 UI는 배경 합성 후 검증합니다.","type":"text"}]},{"type":"heading","anchor":"%EA%B8%B0%EC%A1%B4-%ED%85%8C%EB%A7%88-%EB%AC%B6%EA%B8%B0%EC%99%80-%EC%99%B8%EB%B6%80-%EC%9E%85%EB%A0%A5-%EA%B2%80%EC%A6%9D","level":2,"text":"기존 테마 묶기와 외부 입력 검증"},{"type":"codeListing","syntax":"swift","code":["let pair = MaterialThemePair(","    light: MaterialTheme.preset(.fidelity, appearance: .light),","    dark: MaterialTheme.preset(.fidelity, appearance: .dark)",")","\/\/ SwiftUI 루트: ContentView().materialTheme(light: pair.light, dark: pair.dark)","let expected = MaterialContrastIssue(colorRole: \"warning\", onRole: \"onWarning\", ratio: 1)","let issues = pair.light.colorScheme.contrastIssues()","assert(!issues.contains(expected))","do {","    let checked = try pair.light.colorScheme.validatedContrastIssues(minimum: 4.5)","    assert(checked.isEmpty)","} catch MaterialContrastError.invalidMinimum(let value) {","    print(\"대비 기준은 유한한 1...21이어야 합니다: \\(value)\")","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MaterialThemePair.init(light:dark:)"},{"text":"는 색과 appearance 메타데이터를 그대로 보관합니다.","type":"text"},{"text":" ","type":"text"},{"text":"인수 이름은 표시할 모드를 지정하므로 앱이 각 모드에 맞는 테마를 전달해야 합니다.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"MaterialContrastIssue.init(colorRole:onRole:ratio:)"},{"text":"는 테스트 기대값 등 진단 기록을","type":"text"},{"text":" ","type":"text"},{"text":"직접 구성하며 입력을 검증하거나 대비를 계산하지 않습니다.","type":"text"},{"text":" ","type":"text"},{"text":"외부 설정에는 throwing ","type":"text"},{"type":"codeVoice","code":"validatedContrastIssues"},{"text":"를 사용하세요. 기존 ","type":"text"},{"type":"codeVoice","code":"contrastIssues"},{"text":"의","type":"text"},{"text":" ","type":"text"},{"text":"유한한 1…21 precondition은 유지하며 값을 자동으로 보정하지 않습니다.","type":"text"}]},{"type":"heading","anchor":"%EB%8C%80%EB%B9%84-%EC%98%A4%EB%A5%98-%EB%B9%84%EA%B5%90","level":3,"text":"대비 오류 비교"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MaterialContrastError"},{"type":"text","text":"는 "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":"을 지원합니다. 같은 숫자 기준은 같고, 모든 NaN은"},{"type":"text","text":" "},{"type":"text","text":"같은 잘못된 입력 범주로 비교합니다. +∞와 −∞는 다르고, +0과 −0은 같습니다."},{"type":"text","text":" "},{"type":"text","text":"비교 정책은 원래 연관값을 바꾸지 않아 패턴 매칭으로 NaN의 원래 비트도 읽을 수 있습니다."}]},{"syntax":"swift","typ