-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme\/contrastIssues(minimum:)","doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme\/validatedContrastIssues(minimum:)"],"title":"Contrast Validation","anchor":"Contrast-Validation"},{"identifiers":["doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColor","doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorError","doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialPalette"],"title":"Material Colors","anchor":"Material-Colors"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/materialdesigncolorcore\/materialdesigncolorcore"]}],"hierarchy":{"paths":[["doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore"]]},"kind":"article","metadata":{"role":"collectionGroup","title":"MaterialDesignColorCore","modules":[{"name":"MaterialDesignColorCore"}],"roleHeading":"API Collection"},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"code":"MaterialDesignColorCore","type":"codeVoice"},{"type":"text","text":" contains the platform-neutral Swift model for this package. It exposes the legacy Material Design palette through "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialPalette","isActive":true},{"type":"text","text":" and Material 3 role-based color schemes through "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialTheme","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The default light and dark themes use the official Material 3 "},{"code":"tonalSpot","type":"codeVoice"},{"type":"text","text":" preset. Other official preset variants are available through "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialThemePreset","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"tonalSpot"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"fidelity"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"content"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"monochrome"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"neutral"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"vibrant"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"expressive"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"rainbow"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"fruitSalad"}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","code":["let theme = MaterialTheme.preset(.expressive, appearance: .light)","let primary = theme.colorScheme.primary","let keyPrimary = MaterialThemePreset.expressive.keyColors.primary"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Material Theme Builder role colors can be injected with type-safe "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorRole","isActive":true},{"type":"text","text":" keys. Missing roles fall back to the selected preset."}],"type":"paragraph"},{"syntax":"swift","code":["let theme = try MaterialTheme.custom(","    appearance: .light,","    overrides: [","        .primary: \"#6750A4\",","        .onPrimary: \"#FFFFFF\",","        .primaryContainer: \"#EADDFF\",","        .onPrimaryContainer: \"#21005D\",","        .surface: \"#FFFBFE\",","        .onSurface: \"#1C1B1F\"","    ]",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"For existing call sites, "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialTheme\/light","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialTheme\/dark","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme\/baselineLight","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme\/baselineDark","isActive":true},{"type":"text","text":" remain aliases for the "},{"code":"tonalSpot","type":"codeVoice"},{"type":"text","text":" preset."}],"type":"paragraph"},{"text":"Custom status colors","anchor":"Custom-status-colors","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The standard 48 roles remain unchanged. "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialExtendedColorRole","isActive":true},{"type":"text","text":" defines"},{"type":"text","text":" "},{"type":"text","text":"success\/onSuccess\/successContainer\/onSuccessContainer and the corresponding warning group."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialExtendedColors","isActive":true},{"type":"text","text":" stores immutable, harmonized light\/dark defaults."},{"type":"text","text":" "},{"type":"text","text":"Access them through "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme\/success","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialColorScheme\/warning","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let safe = MaterialTheme.light.colorScheme.success","let scheme = try MaterialColorScheme.tonalSpotDark.overridingExtended([","  .warning: \"#FFB870\", .onWarning: \"#482900\"","])","let theme = MaterialTheme(colorScheme: scheme)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"In the SwiftUI adapter, apply "},{"code":".materialTheme(preset: .tonalSpot)","type":"codeVoice"},{"type":"text","text":" at the root to"},{"type":"text","text":" "},{"type":"text","text":"follow the system appearance, or "},{"code":".materialTheme(light: customLight, dark: customDark)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The AppKit adapter provides "},{"code":"MaterialColor.nsColor","type":"codeVoice"},{"type":"text","text":" and "},{"code":"NSColor(materialColor:)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Seed-based schemes can be generated ahead of time with "},{"code":"tools\/theme\/generate.mjs","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"see the repository README for installation and output formats."}],"type":"paragraph"},{"text":"템플릿 값과 앱 확정 값","anchor":"%ED%85%9C%ED%94%8C%EB%A6%BF-%EA%B0%92%EA%B3%BC-%EC%95%B1-%ED%99%95%EC%A0%95-%EA%B0%92","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"패키지는 롤 이름·구조와 템플릿 기본값, 주입 API, 대비 검증 도구를 제공합니다."},{"type":"text","text":" "},{"type":"text","text":"최종 제품 색은 앱이 확정합니다. success\/warning 기본값은 #6750A4에 조화시킨 템플릿이며,"},{"type":"text","text":" "},{"type":"text","text":"앱이 제품 색상을 결정해 덮어쓰는 것을 전제로 합니다. 런타임 override는 앱 값을 재조화하지 않습니다."}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"경로","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"용도","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"프리셋","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"기본 역할 값의 출발점","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"tools\/theme","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"seed로 후보 스킴을 생성해 앱 프로젝트에 보관","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"값 기반 override \/ pair","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"앱 디자인·사용자 설정·시스템 색의 최종 값 주입","type":"text"}]}]]],"header":"row","type":"table"},{"syntax":"swift","code":["let warning = MaterialColor(name: \"appWarning\", red: 128, green: 64, blue: 0)","let white = MaterialColor(name: \"white\", red: 255, green: 255, blue: 255)","let pair = MaterialTheme.pair(extendedLight: [.warning: warning, .onWarning: white])","let ratio = warning.contrastRatio(with: white)","let issues = pair.light.colorScheme.contrastIssues(minimum: 4.5)"],"type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialExtendedColors","isActive":true},{"type":"text","text":"의 공개 생성자는 모든 확장 역할을 MaterialColor로 받습니다."},{"type":"text","text":" "},{"type":"text","text":"UInt8 sRGB 생성자와 값 기반 overriding\/custom은 throw하지 않습니다."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialThemePair","isActive":true},{"type":"text","text":"의 light\/dark를 SwiftUI "},{"code":".materialTheme(light:dark:)","type":"codeVoice"},{"type":"text","text":" 또는"},{"type":"text","text":" "},{"type":"text","text":"AppKit\/UIKit "},{"code":".material(light:dark:_:)","type":"codeVoice"},{"type":"text","text":"에 전달하세요."}],"type":"paragraph"},{"inlineContent":[{"code":"\\.materialTheme","type":"codeVoice"},{"type":"text","text":" 환경 기본값은 MaterialTheme.light입니다. 모디파이어가 없는 장면은"},{"type":"text","text":" "},{"type":"text","text":"자동 전환되지 않으므로 별도 창·설정 창에도 각 루트에 주입해야 합니다."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialContrastIssue","isActive":true},{"type":"text","text":"는 기본·확장 on 쌍의 미달 대비를 반환합니다. 실제 다른 인접 색상은"},{"type":"text","text":" "},{"type":"text","text":"contrastRatio(with:)로 검사하세요. 투명도가 적용된 UI는 배경 합성 후 검증합니다."}],"type":"paragraph"},{"text":"기존 테마 묶기와 외부 입력 검증","anchor":"%EA%B8%B0%EC%A1%B4-%ED%85%8C%EB%A7%88-%EB%AC%B6%EA%B8%B0%EC%99%80-%EC%99%B8%EB%B6%80-%EC%9E%85%EB%A0%A5-%EA%B2%80%EC%A6%9D","level":2,"type":"heading"},{"syntax":"swift","code":["let pair = MaterialThemePair(","    light: MaterialTheme.preset(.fidelity, appearance: .light),","    dark: MaterialTheme.preset(.fidelity, appearance: .dark)",")","\/\/ SwiftUI 루트: ContentView().materialTheme(light: pair.light, dark: pair.dark)","let expected = MaterialContrastIssue(colorRole: \"warning\", onRole: \"onWarning\", ratio: 1)","let issues = pair.light.colorScheme.contrastIssues()","assert(!issues.contains(expected))","do {","    let checked = try pair.light.colorScheme.validatedContrastIssues(minimum: 4.5)","    assert(checked.isEmpty)","} catch MaterialContrastError.invalidMinimum(let value) {","    print(\"대비 기준은 유한한 1...21이어야 합니다: \\(value)\")","}"],"type":"codeListing"},{"inlineContent":[{"code":"MaterialThemePair.init(light:dark:)","type":"codeVoice"},{"type":"text","text":"는 색과 appearance 메타데이터를 그대로 보관합니다."},{"type":"text","text":" "},{"type":"text","text":"인수 이름은 표시할 모드를 지정하므로 앱이 각 모드에 맞는 테마를 전달해야 합니다."},{"type":"text","text":" "},{"code":"MaterialContrastIssue.init(colorRole:onRole:ratio:)","type":"codeVoice"},{"type":"text","text":"는 테스트 기대값 등 진단 기록을"},{"type":"text","text":" "},{"type":"text","text":"직접 구성하며 입력을 검증하거나 대비를 계산하지 않습니다."},{"type":"text","text":" "},{"type":"text","text":"외부 설정에는 throwing "},{"code":"validatedContrastIssues","type":"codeVoice"},{"type":"text","text":"를 사용하세요. 기존 "},{"code":"contrastIssues","type":"codeVoice"},{"type":"text","text":"의"},{"type":"text","text":" "},{"type":"text","text":"유한한 1…21 precondition은 유지하며 값을 자동으로 보정하지 않습니다."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.swift-man.MaterialDesignColor.MaterialDesignColorCore\/documentation\/MaterialDesignColorCore\/MaterialDesignColorCore","interfaceLanguage":"swift"},"abstract":[{"text":"Use Material Design palette constants and official Material 3 preset color schemes from a pure Swift target.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.swift-man.MaterialDesignColor.MaterialDesignColorCore/documentation/MaterialDesignColorCore/MaterialColorScheme/contrastIssues(minimum:)":{"url":"\/documentation\/materialdesigncolorcore\/materialcolorscheme\/contrastissues(minimum:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contrastIssues","kind":"identifier"},{"text":"(","kind":"text"},{"text":"minimum","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Double","kind":"typeIdentifier","preciseIdentifier":